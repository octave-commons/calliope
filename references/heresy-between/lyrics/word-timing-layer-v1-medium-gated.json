      "end_s": 14.979999542236328,
      "text": "言えなかった ごめんねよりもっと可愛いのは"
    },
    {
      "index": 3,
      "start_s": 14.979999542236328,
      "end_s": 21.31999969482422,
      "text": "何も贈らないっていう 静かな洗濯"
    },
    {
      "index": 4,
      "start_s": 21.31999969482422,
      "end_s": 24.979999542236328,
      "text": "理由はいつも 後悔"
    },
    {
      "index": 5,
      "start_s": 24,
      "end_s": 27,
      "text": "夢は後からなら選べれる"
    },
    {
      "index": 6,
      "start_s": 27,
      "end_s": 30,
      "text": "でも指先は先に"
    },
    {
      "index": 7,
      "start_s": 30,
      "end_s": 33,
      "text": "生き方を知ってしまう"
    },
    {
      "index": 8,
      "start_s": 33,
      "end_s": 35,
      "text": "一行だけのメッセージ"
    },
    {
      "index": 9,
      "start_s": 35,
      "end_s": 38,
      "text": "この世の形が決まるなら"
    },
    {
      "index": 10,
      "start_s": 38,
      "end_s": 41,
      "text": "僕は逃げ道の言い訳より"
    },
    {
      "index": 11,
      "start_s": 41,
      "end_s": 44,
      "text": "小さな責任を選びたいね"
    },
    {
      "index": 12,
      "start_s": 44,
      "end_s": 47,
      "text": "さよならの続きかけなくて"
    },
    {
      "index": 13,
      "start_s": 47,
      "end_s": 49,
      "text": "くわへくばかり増えて"
    },
    {
      "index": 14,
      "start_s": 48,
      "end_s": 50,
      "text": "ばかり増えていくけど"
    },
    {
      "index": 15,
      "start_s": 50,
      "end_s": 53,
      "text": "一行だけのメッセージで"
    },
    {
      "index": 16,
      "start_s": 53,
      "end_s": 56,
      "text": "意味を置いて帰るよ"
    },
    {
      "index": 17,
      "start_s": 56,
      "end_s": 60,
      "text": "タイムラインには知らない誰かの笑顔"
    },
    {
      "index": 18,
      "start_s": 60,
      "end_s": 65,
      "text": "強がってスクロールして心だけ取り残す"
    },
    {
      "index": 19,
      "start_s": 65,
      "end_s": 69,
      "text": "打ち掛けの言葉が震えて消えてくたび"
    },
    {
      "index": 20,
      "start_s": 69,
      "end_s": 73,
      "text": "どうせの物語がまたオープン"
    },
    {
      "index": 21,
      "start_s": 72,
      "end_s": 75.5,
      "text": "青くないよカブル"
    },
    {
      "index": 22,
      "start_s": 76,
      "end_s": 81,
      "text": "きっと決まってるって口にした瞬間"
