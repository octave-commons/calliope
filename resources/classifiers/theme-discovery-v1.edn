{:classifier-dsl/version 1
 :program/id :fork-tales/theme-discovery-v1
 :program/description
 "Discover provisional shared concepts from reproducible random groups of ten songs."

 :sources
 {:fork-tales/songs-v1
  {:source/id :fork-tales/songs-v1
   :source/type :edn-projection
   :source/location "ledgers/projections/songs-v1.edn"
   :source/object-type :work
   :source/options {:canonical-lyrics-root "docs/lyrics"}}}

 :models
 {:fork-tales/gemma4-e4b-ollama
  {:model/id :fork-tales/gemma4-e4b-ollama
   :model/provider :ollama
   :model/name "gemma4:e4b"
   :model/endpoint "http://127.0.0.1:11434"
   :model/modalities #{:text :image :audio}
   :model/options {:num_ctx 32768
                   :temperature 0.2}}

  :fork-tales/gemma4-e4b-llama-cpp
  {:model/id :fork-tales/gemma4-e4b-llama-cpp
   :model/provider :llama-cpp
   :model/name "gemma4:e4b"
   :model/endpoint "http://127.0.0.1:8080/v1/chat/completions"
   :model/modalities #{:text :image :audio}
   :model/options {:n_ctx 32768
                   :temperature 0.2}}

  :fork-tales/gemma4-e2b-ollama
  {:model/id :fork-tales/gemma4-e2b-ollama
   :model/provider :ollama
   :model/name "gemma4:e2b"
   :model/endpoint "http://127.0.0.1:11434"
   :model/modalities #{:text :image :audio}
   :model/options {:num_ctx 16384
                   :temperature 0.1}}}

 :selectors
 {:fork-tales/random-ten-works-v1
  {:selector/id :fork-tales/random-ten-works-v1
   :selector/type :random
   :selector/source :fork-tales/songs-v1
   :selector/count 10
   :selector/seed :run-seed
   :selector/where [:not [:contains :flags :pasted-artifact]]
   :selector/distinct-by :body-sha256}}

 :contexts
 {:fork-tales/ten-lyric-sections-v1
  {:context/id :fork-tales/ten-lyric-sections-v1
   :context/selector :fork-tales/random-ten-works-v1
   :context/steps
   [{:step/op :hydrate
     :step/resolver :fork-tales/canonical-lyric-v1
     :step/modalities #{:text}
     :step/as :lyrics}
    {:step/op :segment
     :step/input :lyrics
     :step/strategy :explicit-song-sections
     :step/as :sections}
    {:step/op :limit
     :step/input :sections
     :step/max-chars-per-object 12000
     :step/overflow :truncate-tail}
    {:step/op :render
     :step/input :sections
     :step/template
     "## {{title}}\nObject ID: {{object/id}}\n\n{{sections}}\n"
     :step/as :context/songs}]
   :context/output-key :context/songs
   :context/token-budget {:max-tokens 28000
                          :overflow :drop-largest-object}}}

 :prompts
 {:fork-tales/shared-concepts-v1
  {:prompt/id :fork-tales/shared-concepts-v1
   :prompt/version 1
   :prompt/variables #{:context/songs :run/seed}
   :prompt/response-format :edn
   :prompt/messages
   [{:message/role :system
     :message/template
     "You are a conservative comparative analyst of one evolving song corpus. Treat every interpretation as provisional. Shared vocabulary alone is not a shared theme. Never claim evidence outside the supplied objects."}
    {:message/role :user
     :message/template
     "The following ten works were selected with reproducible seed {{run/seed}}.\n\n{{context/songs}}\n\nIdentify at most eight concepts meaningfully shared by at least two works. A concept may be a theme, proposition, motif, narrative function, emotional trajectory, rhetorical device, or production pattern. Prefer precise concepts such as 'technical failure as personal exhaustion' over generic topics such as 'technology' or 'emotion'.\n\nFor every concept:\n- give a precise name and one-sentence definition;\n- choose the narrowest scope justified by the evidence;\n- identify every supporting object and exact lyric quote;\n- explain the shared basis;\n- explain one important difference between examples;\n- assign confidence from 0.0 to 1.0.\n\nReturn one EDN map matching the supplied output contract. Return no prose outside the EDN value."}]}}

 :outputs
 {:fork-tales/theme-discovery-result-v1
  {:output/id :fork-tales/theme-discovery-result-v1
   :output/format :edn
   :output/on-invalid :repair-once
   :output/max-repair-attempts 1
   :output/schema
   [:map {:closed true}
    [:batch-summary [:string {:min 1}]]
    [:concepts
     [:vector {:max 8}
      [:map {:closed true}
       [:concept/name [:string {:min 3}]]
       [:concept/family
        [:enum :theme :proposition :motif :narrative-function
         :emotional-trajectory :rhetorical-device :production-pattern]]
       [:concept/definition [:string {:min 10}]]
       [:concept/scope [:enum :work :song-section :text-span]]
       [:concept/members
        [:vector {:min 2}
         [:map {:closed true}
          [:object/id [:string {:min 1}]]
          [:section/id {:optional true} [:string {:min 1}]]
          [:evidence/quote [:string {:min 1}]]
          [:evidence/explanation [:string {:min 1}]]]]]
       [:concept/shared-basis [:string {:min 1}]]
       [:concept/important-difference [:string {:min 1}]]
       [:concept/confidence [:double {:min 0.0 :max 1.0}]]]]]]}}

 :classifiers
 {:fork-tales/random-ten-theme-discovery-v1
  {:classifier/id :fork-tales/random-ten-theme-discovery-v1
   :classifier/version 1
   :classifier/kind :concept-discovery
   :classifier/description
   "Propose shared concepts from ten randomly selected lyric works."
   :classifier/model :fork-tales/gemma4-e4b-ollama
   :classifier/fallback-models [:fork-tales/gemma4-e4b-llama-cpp]
   :classifier/context :fork-tales/ten-lyric-sections-v1
   :classifier/prompt :fork-tales/shared-concepts-v1
   :classifier/output :fork-tales/theme-discovery-result-v1
   :classifier/emits {:event/type :concept/discovered
                      :event/ledger "ledgers/classification.edn"
                      :event/status :provisional}
   :classifier/runtime {:timeout-ms 180000
                        :max-attempts 2
                        :temperature 0.2}}}}
